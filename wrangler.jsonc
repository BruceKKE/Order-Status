{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "order-status-live",
  "main": "src/index.js",
  "compatibility_date": "2026-08-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "CACHE_SECONDS": "60"
  },
  "observability": {
    "enabled": true
  }
}
